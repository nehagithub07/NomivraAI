{
  "name": "nomvira-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "db:prepare": "node scripts/prepare-trip-database.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "test:deployment": "node --test tests/deployment.test.mjs",
    "test:itineraries": "node --experimental-strip-types --test tests/itineraries.test.mjs tests/itineraries-bff.test.mjs tests/itineraries-db.test.mjs",
    "test:budget": "node --experimental-strip-types --test tests/budget.test.mjs tests/budget-bff.test.mjs tests/budget-db.test.mjs",
    "test:weather": "node --experimental-strip-types --test tests/weather.test.mjs tests/weather-bff.test.mjs tests/weather-db.test.mjs",
    "test:companion": "node --experimental-strip-types --test tests/companion.test.mjs tests/companion-bff.test.mjs tests/companion-db.test.mjs",
    "test:auth": "node --experimental-strip-types --test tests/auth.test.mjs tests/auth-network.test.mjs tests/supabase-connector.test.mjs",
    "test:trips": "node --experimental-strip-types --test tests/trips.test.mjs",
    "test:accommodations": "node --experimental-strip-types --test tests/accommodations.test.mjs tests/accommodations-db.test.mjs tests/accommodations-bff.test.mjs",
    "test:food": "node --experimental-strip-types --test tests/food.test.mjs tests/food-db.test.mjs tests/food-bff.test.mjs",
    "test:destinations": "node --experimental-strip-types --test tests/destinations.test.mjs tests/destinations-db.test.mjs tests/destinations-bff.test.mjs tests/trip-database-setup.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "^1.8.2",
    "lucide-react": "1.61.0",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
