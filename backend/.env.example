NOMVIRA_INTERNAL_API_KEY=
FRONTEND_ORIGIN=http://localhost:3000
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
PROVIDER_USER_AGENT=NomviraAI/0.1
DEFAULT_POI_RADIUS_METERS=10000
MAX_POI_RADIUS_METERS=20000
APP_ENV=development
ACCOMMODATION_PROVIDER=fixture
ALLOW_DEMO_ACCOMMODATIONS=true
STAYAPI_API_KEY=
STAYAPI_BASE_URL=https://api.stayapi.com
ACCOMMODATION_CACHE_TTL_SECONDS=900
ACCOMMODATION_CACHE_MAX_ENTRIES=128
FOOD_PROVIDER=geoapify
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com
DEFAULT_FOOD_RADIUS_METERS=5000
FOOD_CACHE_TTL_SECONDS=900
FOOD_CACHE_MAX_ENTRIES=128

# FastAPI only. Fixture planning is explicit and disabled in production.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Itinerary generation and weather adaptation use their own latency-sensitive model.
GEMINI_ITINERARY_MODEL=gemini-3.6-flash

# Weather calls stay in FastAPI. This is a base URL; /forecast is appended.
WEATHER_PROVIDER=open_meteo
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1
