APP_ENV=development
# Render must use APP_ENV=production; /ready is the readiness check, /health is liveness.
# Vercel calls this service through the authenticated BFF; do not add wildcard CORS.

FRONTEND_ORIGIN=http://localhost:3000

NOMVIRA_INTERNAL_API_KEY=

OVERPASS_API_URL=https://overpass.private.coffee/api/interpreter
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1
WEATHER_PROVIDER=open_meteo
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1
OVERPASS_FALLBACK_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
OVERPASS_LAST_RESORT_URL=https://overpass-api.de/api/interpreter
DEFAULT_POI_RADIUS_METERS=30000
MAX_POI_RADIUS_METERS=30000

ACCOMMODATION_PROVIDER=stayapi
ALLOW_DEMO_ACCOMMODATIONS=false
STAYAPI_API_KEY=
STAYAPI_BASE_URL=https://api.stayapi.com

FOOD_PROVIDER=google_maps
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com
DEFAULT_FOOD_RADIUS_METERS=10000

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ITINERARY_MODEL=gemini-3.6-flash
GEMINI_MAX_REQUESTS_PER_MINUTE=30
GEMINI_DAILY_TOKEN_LIMIT=1000000
PROVIDER_MAX_REQUESTS_PER_MINUTE=120
# Optional current USD token prices per model. Empty means costs remain unavailable.
# Fields: input_per_million, output_per_million, optional cached_input_per_million.
GEMINI_PRICING_JSON={}
# Memory embeddings use this same private key; exports/sharing never call Gemini.

ROUTING_PROVIDER=openrouteservice
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.heigit.org/openrouteservice/v2

ROUTING_CACHE_TTL_SECONDS=21600
ROUTING_CACHE_MAX_ENTRIES=256
