# Supabase Project Settings / Connect
# Use a publishable key, never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NOMVIRA_API_URL=http://127.0.0.1:8001

# Internal API Authentication
NOMVIRA_INTERNAL_API_KEY=

# Map Configuration
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Production: set NEXT_PUBLIC_SITE_URL to the canonical HTTPS Vercel origin.
# Export uses saved trip data. Sharing reuses the internal key above to seal link tokens.
# Rotating that key requires revoking existing links and creating replacements.
# Keep Gemini, StayAPI, Geoapify and openrouteservice keys only in backend/.env / Render.
