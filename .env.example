# Supabase Project Settings / Connect. Use a publishable key, never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Canonical application origin. Required in production; defaults to localhost in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NOMVIRA_API_URL=http://127.0.0.1:8001
NOMVIRA_INTERNAL_API_KEY=
